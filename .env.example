# Backend (backend/.env)
DATABASE_URL=postgresql+asyncpg://operator_os:operator_os@localhost:5432/operator_os
JWT_SECRET=change-me-in-dev
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
MQTT_HOST=localhost
MQTT_PORT=1883
# Get a free key at https://openrouter.ai/keys — check openrouter.ai/models?max_price=0
# for the current free-tier catalog before picking model slugs.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ASSISTANT_FAST_MODEL=nex-agi/nex-n2.5-mini:free
ASSISTANT_STRONG_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ENV=development

# Mobile (mobile/.env or app.config.ts extra)
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_MQTT_WS_URL=ws://localhost:9001
# Where UnitySim's WebGL fallback tier loads from — see unity/OperatorSim/README.md
EXPO_PUBLIC_UNITY_WEBGL_URL=/unity/index.html
